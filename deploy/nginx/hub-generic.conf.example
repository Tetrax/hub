# SNS Hub — exemple de vhost Nginx GÉNÉRIQUE (installation externe).
#
# Ce fichier est un EXEMPLE à adapter : il ne remplace pas la variante de
# production du VPS (`deploy/nginx/hub.valdev.me.conf`, qui garde l'allowlist
# globale, la structure Ubuntu et les fichiers Certbot).
#
# Il ne suppose NI Certbot, NI `/etc/letsencrypt/options-ssl-nginx.conf`,
# NI allowlist globale : uniquement un certificat et une clé que VOUS fournissez
# (certificat d'entreprise, Let's Encrypt obtenu autrement, etc.).
#
# Placeholders à remplacer :
#   HOSTNAME     → nom DNS public du Hub (ex. hub.intra.example)
#   UPSTREAM     → adresse du conteneur (ex. 127.0.0.1:13744)
#   CERT_PATH    → certificat serveur (chaîne complète si applicable)
#   KEY_PATH     → clé privée correspondante
#   ACME_ROOT    → (optionnel) racine webroot pour un renouvellement ACME
#
# Sur RHEL/Rocky/Alma : déposer ce fichier dans /etc/nginx/conf.d/ (la
# structure sites-available/sites-enabled est propre à Debian/Ubuntu).

server {
    listen 80;
    listen [::]:80;
    server_name HOSTNAME;

    # Renouvellement ACME (facultatif — supprimer si non utilisé).
    location ~ ^/\.well-known/acme-challenge/[A-Za-z0-9_-]+$ {
        allow all;
        root ACME_ROOT;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name HOSTNAME;

    ssl_certificate     CERT_PATH;
    ssl_certificate_key KEY_PATH;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Taille des écrans envoyés à l'admin (screenshots) ; cohérent avec l'application.
    client_max_body_size 10m;

    location / {
        proxy_pass http://UPSTREAM;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;
    }
}

# IMPORTANT : côté Hub, déclarer ce proxy comme seul émetteur de confiance :
#   HUB_TRUSTED_PROXY_CIDRS=<IP source du proxy>   (dans .env)
# Sans cette valeur, le Hub ignore X-Forwarded-Proto : il ne détecte pas le
# HTTPS (cookie de session sans Secure, pas de HSTS) et journalise l'IP du proxy.
