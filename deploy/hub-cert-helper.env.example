# Environnement du helper certificat SNS Hub (service root).
# Copie de référence : /etc/hub-cert-helper.env doit être en 0600 root:root.
# Ce fichier ne contient aucun secret ; il borne les chemins et le domaine géré.

HUB_TLS_HOSTNAME=hub.valdev.me
HUB_CERT_OUTPUT_DIR=/var/lib/hub/certificates/active
HUB_CERT_STAGING_DIR=/var/lib/hub/certificates/staging
HUB_CERT_HELPER_SOCKET=/run/hub-cert-helper/helper.sock

# UID/GID autorisés à dialoguer avec la socket (processus applicatif du conteneur).
HUB_PUID=1000
HUB_PGID=1000

# Rechargement Nginx + vérification du certificat servi après chaque activation.
HUB_CERT_RELOAD_NGINX=1
HUB_HTTPS_PORT=443
HUB_NGINX_BIN=/usr/sbin/nginx
HUB_SYSTEMCTL=/usr/bin/systemctl
