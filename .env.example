# SNS Hub — configuration d'installation.
#
#   cp .env.example .env    puis ajustez les valeurs, puis :
#   sudo install -d -o <HUB_UID> -g <HUB_GID> runtime/data
#   docker compose up -d --build
#
# `.env` n'est JAMAIS versionné (seul `.env.example` l'est) et ne doit contenir
# aucun secret. Format simple : KEY=value, une par ligne, sans commentaire en
# fin de ligne (le fichier est aussi lu par les scripts de `scripts/`).

# --- Accès réseau -----------------------------------------------------------
# IP d'écoute du port publié. 127.0.0.1 = reverse proxy sur la même machine
# (défaut sûr). 0.0.0.0 = accès direct depuis le réseau : à réserver à un
# réseau de confiance et à protéger par un pare-feu / des ACL.
HUB_BIND_IP=127.0.0.1
# Port publié sur l'hôte (le conteneur écoute en interne sur 8000).
HUB_PORT=13744

# --- Utilisateur applicatif -------------------------------------------------
# Le conteneur tourne avec cet UID/GID ; le répertoire de données doit lui
# appartenir :  sudo install -d -o 1000 -g 1000 runtime/data
HUB_UID=1000
HUB_GID=1000

# --- Branding (header) ------------------------------------------------------
# Libellé affiché à côté du logo SNS, dans le header (« HUB » par défaut, soit
# « SNS | HUB »). Purement visuel : aucun effet sur le hostname, le certificat,
# la base, les sessions ni les URLs. Texte simple (échappé, 40 caractères max).
#HUB_BRAND_LABEL=HUB

# --- Surveillance Trivy (optionnel, V1.6) -----------------------------------
# Le scan Trivy reste dans GitHub Actions ; le Hub consomme l'artefact
# `trivy-report` de Tetrax/hub pour afficher l'état de l'image et n'envoyer un
# email qu'en cas de changement. Jeton GitHub en LECTURE SEULE (fine-grained,
# portée « Actions: Read » sur Tetrax/hub) : le téléchargement d'artefact
# l'exige même pour un dépôt public (vérifié). Vide = surveillance non
# activable. Le mot de passe SMTP sert uniquement aux alertes email.
#HUB_GITHUB_TOKEN=
#HUB_SMTP_PASSWORD=
# Planification interne (défaut : activée, cadence horaire). 0 = aucun thread.
#HUB_TRIVY_SCHEDULER=1

# --- TLS et proxy -----------------------------------------------------------
# Hostname attendu dans le certificat TLS (affichage + validation helper).
# Peut rester vide si aucun certificat n'est géré par le Hub.
HUB_TLS_HOSTNAME=
# IP/CIDR du reverse proxy autorisé à fournir X-Forwarded-Proto/-For :
# indispensable pour que le Hub détecte le HTTPS (cookie Secure, HSTS) quand le
# TLS est terminé en amont. Vide = aucun proxy de confiance.
# Exemple derrière un load balancer : HUB_TRUSTED_PROXY_CIDRS=10.20.30.5/32
HUB_TRUSTED_PROXY_CIDRS=
# Helper certificat (root, service systemd) — optionnel pour l'application :
# sans lui, la page Certificats signale son absence et le reste du Hub fonctionne.
#HUB_CERT_HELPER_SOCKET=/run/hub-cert-helper/helper.sock
#HUB_CERT_HELPER_DIR=/run/hub-cert-helper

# --- Données, image, sauvegardes -------------------------------------------
# Emplacement des données persistantes sur l'hôte (SQLite, uploads, clé de session).
#HUB_DATA_PATH=./runtime/data
# Nom du conteneur (à changer pour faire cohabiter deux installations).
#HUB_CONTAINER_NAME=hub-web
# Image à déployer : soit un tag local, soit un SHA Git (scripts/build.sh).
#HUB_IMAGE_TAG=local
# Destination des archives de sauvegarde (scripts/backup.sh). Défaut : ./backups/hub
#HUB_BACKUP_DIR=/var/backups/hub
# Nombre d'archives conservées.
#HUB_BACKUP_KEEP=10

# --- Fichiers Compose -------------------------------------------------------
# VPS de production : charge aussi la surcharge locale (sous-réseau fixé, proxy
# de confiance, hostname). Sur une VM générique : laisser commenté.
#COMPOSE_FILE=compose.yaml:compose.vps.yaml

# --- Mode standalone (Portainer, compose.standalone.yaml) -------------------
# Ces valeurs se saisissent dans Portainer → Stacks → Add stack → Repository →
# « Environment variables » (elles n'ont aucun effet sur compose.yaml).
# Rattachement à un réseau Docker EXISTANT :
#   HUB_DOCKER_NETWORK=<nom du réseau>          (vide = réseau du stack, défaut)
#   HUB_DOCKER_NETWORK_EXTERNAL=true            (optionnel : exige que le réseau
#                                                existe déjà — sinon Compose
#                                                peut en créer un homonyme)
#   HUB_IPV4_ADDRESS=                           (optionnel : IPv4 statique ; le
#                                                réseau cible doit avoir un
#                                                sous-réseau qui la contient)
# Laisser vide pour un déploiement standard : Docker attribue alors une adresse.
#HUB_DOCKER_NETWORK=
#HUB_DOCKER_NETWORK_EXTERNAL=
#HUB_IPV4_ADDRESS=
# Libellé du header de cette instance (voir « Branding » ci-dessus) : à saisir
# aussi dans les Environment variables de la stack Portainer si personnalisé.
#HUB_BRAND_LABEL=
